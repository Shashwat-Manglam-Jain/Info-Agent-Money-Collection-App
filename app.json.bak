{
  "expo": {
    "name": "Info Agent Money Collection",
    "slug": "info-agent-money-collection",
    "scheme": "iamc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
       "image": "./assets/splash.png",  
      "resizeMode": "contain",        
      "backgroundColor": "#0A0F1E"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1220"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jay.infoagentmoneycollection",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#d8dce5",
          "dark": {
            "image": "./assets/newlogo.png",
            "backgroundColor": "#d8dce5"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "3e7abecc-b71c-4d57-8424-666153ab89c7"
      }
    },
    "owner": "jay123y"
  }
}


